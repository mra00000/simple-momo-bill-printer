{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momo-bill-printer-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatSession"] }],

  "vars": {
    // Seconds to wait after the last image before printing automatically.
    // Set to "0" to only print when you send /print.
    "AUTO_PRINT_DELAY_SECONDS": "0",
    // Comma-separated Telegram user IDs allowed to use the bot. Empty = anyone.
    "ALLOWED_USER_IDS": ""
  }

  // Secrets (set with `npx wrangler secret put <NAME>`, never commit them):
  //   TELEGRAM_BOT_TOKEN  – from @BotFather
  //   WEBHOOK_SECRET      – any random string; Telegram sends it back on every webhook call
}
